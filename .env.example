# Copy to .env:   cp .env.example .env
# These values give a working LOCAL demo. Replace every change-me value before sharing the server.
# .env is read only from this repository (repository root or backend/), never from the current directory.

# development | test | production. production refuses to start with DEMO_MODE=true, a missing/short/placeholder
# SECRET_KEY, placeholder ADMIN_TOKEN/DEMO_COMPANY_PASSWORD, a wildcard CORS origin or the vsp:vsp DB credentials.
ENVIRONMENT=development

# --- Database (used by docker compose; local dev uses DATABASE_URL below) ---
POSTGRES_USER=vsp
POSTGRES_PASSWORD=vsp
POSTGRES_DB=vsp_park
# Local (non-Docker) development. Approved database names: vsp_park (app) and vsp_park_test (tests only).
# The original vsp / vsp_test databases (and postgres/template0/template1) are always refused.
DATABASE_URL=postgresql+psycopg://vsp:vsp@localhost:5432/vsp_park
# Deliberate opt-in for one other database name (letters, digits, underscore). Leave empty normally.
VSP_ALLOW_DATABASE=
# Optional server identity, checked on every new connection when set: the server port (inet_server_port) and the
# PostgreSQL system identifier (pg_controldata "Database system identifier"). Empty = not checked.
VSP_EXPECT_SERVER_PORT=
VSP_EXPECT_SYSTEM_IDENTIFIER=
# Tests: TEST_DATABASE_URL must name vsp_park_test unless VSP_ALLOW_TEST_DATABASE names another *_test database.
# The test suite DROPS AND RECREATES the public schema of that database. Database-backed runs also require
# VSP_TEST_EXPECTED_PORT (must equal the port written in TEST_DATABASE_URL); VSP_TEST_EXPECTED_SYSTEM_ID is optional.
# Database-independent tests only: VSP_TEST_NO_DB=1
# TEST_DATABASE_URL=postgresql+psycopg://vsp:vsp@localhost:5432/vsp_park_test
# VSP_ALLOW_TEST_DATABASE=
# VSP_TEST_EXPECTED_PORT=5432
# VSP_TEST_EXPECTED_SYSTEM_ID=

# --- Security ---
# Signs company workspace sessions. Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-string
# Required header (X-Admin-Token) for running collectors. Leave empty to disable collector runs.
ADMIN_TOKEN=change-me-admin-token
# Password for the seeded company accounts (username = company slug, e.g. ocean-harvesting).
# Empty = random password; login then only works through demo mode.
DEMO_COMPANY_PASSWORD=change-me-demo-password
# Demo mode: password-free "open demo workspace" buttons and demo reset without admin token.
# The application default is OFF; it is enabled here only for the local demo. Never enable on a shared server.
DEMO_MODE=true
TOKEN_TTL_MINUTES=480

# --- Behaviour ---
AUTO_SEED=true
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080
# Pin "today" for a reproducible demo (ISO date). Empty = real date.
REFERENCE_DATE=
LOG_LEVEL=INFO

# --- Optional LLM (never required). Only rewords deterministic summaries; output is grounding-checked. ---
# LLM_PROVIDER=none | anthropic        (anthropic requires: pip install ".[llm]")
LLM_PROVIDER=none
LLM_MODEL=claude-opus-5-5
LLM_API_KEY=
